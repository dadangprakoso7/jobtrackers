ng Tbk (cabang Surabaya)", "bidang": "Distribusi farmasi & consumer goods", "website": "www.enseval.com", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 194, "nama": "PT Panin Bank Tbk Cabang Surabaya", "bidang": "Perbankan", "website": "www.panin.co.id", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 195, "nama": "PT Bank CIMB Niaga Tbk Cabang Surabaya", "bidang": "Perbankan", "website": "www.cimbniaga.co.id", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 196, "nama": "PT Bank Danamon Indonesia Tbk Cabang Surabaya", "bidang": "Perbankan", "website": "www.danamon.co.id", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 197, "nama": "PT Asuransi Jasa Indonesia (Jasindo) Cabang Surabaya", "bidang": "Asuransi", "website": "www.jasindo.co.id", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 198, "nama": "PT Jasa Raharja Cabang Jawa Timur", "bidang": "Asuransi (BUMN)", "website": "www.jasaraharja.co.id", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 199, "nama": "PT Pos Indonesia (Persero) Regional Jatim", "bidang": "Logistik & jasa pos (BUMN)", "website": "www.posindonesia.co.id", "sosmed": "-", "lokasi": "Jl. Kebonrojo, Surabaya", "kontak": "-"}, {"no": 200, "nama": "PT KAI (Persero) Daop 8 Surabaya", "bidang": "Transportasi kereta api (BUMN)", "website": "www.kai.id", "sosmed": "-", "lokasi": "Jl. Gubeng Masjid No.1, Surabaya", "kontak": "-"}, {"no": 201, "nama": "PT Angkasa Pura I (Bandara Juanda)", "bidang": "Pengelola bandara (BUMN)", "website": "www.injourneyairports.id", "sosmed": "-", "lokasi": "Bandara Juanda, Sidoarjo", "kontak": "-"}, {"no": 202, "nama": "PT Terminal Petikemas Surabaya (TPS)", "bidang": "Operator terminal peti kemas", "website": "www.tps.co.id", "sosmed": "-", "lokasi": "Jl. Tanjung Mutiara No.1, Surabaya", "kontak": "-"}, {"no": 203, "nama": "PT Meratus Line", "bidang": "Pelayaran & logistik", "website": "www.meratusline.com", "sosmed": "-", "lokasi": "Jl. Perak Barat No.108-110, Surabaya", "kontak": "-"}, {"no": 204, "nama": "PT Salam Pacific Indonesia Lines (SPIL)", "bidang": "Pelayaran & logistik", "website": "www.spil.co.id", "sosmed": "-", "lokasi": "Jl. Yos Sudarso No.1-3, Surabaya", "kontak": "-"}, {"no": 205, "nama": "PT Dharma Lautan Utama", "bidang": "Pelayaran", "website": "www.dlu.co.id", "sosmed": "-", "lokasi": "Jl. Perak Barat No.30, Surabaya", "kontak": "-"}, {"no": 206, "nama": "PT Suzuki Indomobil Motor (dealer utama Surabaya)", "bidang": "Distribusi & dealer otomotif", "website": "www.suzuki.co.id", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 207, "nama": "PT Honda Prospect Motor (dealer utama Surabaya)", "bidang": "Distribusi & dealer otomotif", "website": "www.honda-indonesia.com", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}, {"no": 208, "nama": "PT Toyota Astra Motor (dealer utama Surabaya)", "bidang": "Distribusi & dealer otomotif", "website": "www.toyota.astra.co.id", "sosmed": "-", "lokasi": "Surabaya", "kontak": "-"}];
let state = { search:"", industry:"", area:"", page:1, pageSize:10, sort:"no", dir:"asc" };

const $ = s => document.querySelector(s);
const esc = s => String(s ?? "-").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm = s => String(s ?? "").toLowerCase().trim();

function websiteUrl(v){
  if(!v || v === "-") return null;
  let x = v.trim();
  if(!/^https?:\/\//i.test(x)) x = "https://" + x;
  return x;
}
function uniqueValues(key){
  return [...new Set(DATA.map(x=>x[key]).filter(x=>x && x!=="-"))].sort((a,b)=>a.localeCompare(b,'id'));
}
function init(){
  const sel = $("#industry");
  uniqueValues("bidang").forEach(v=>{
    const o=document.createElement("option"); o.value=v; o.textContent=v; sel.appendChild(o);
  });
  renderStats();
  bind();
  render();
}
function renderStats(){
  const industries = new Set(DATA.map(x=>x.bidang).filter(Boolean));
  const sby = DATA.filter(x=>norm(x.lokasi).includes("surabaya")).length;
  const sda = DATA.filter(x=>norm(x.lokasi).includes("sidoarjo")).length;
  $("#stats").innerHTML = `
    <div class="stat"><div class="label">Total Perusahaan</div><div class="value">${DATA.length}</div></div>
    <div class="stat"><div class="label">Bidang Usaha</div><div class="value">${industries.size}</div></div>
    <div class="stat"><div class="label">Lokasi Surabaya</div><div class="value">${sby}</div></div>
    <div class="stat"><div class="label">Lokasi Sidoarjo</div><div class="value">${sda}</div></div>`;
}
function getFiltered(){
  const q=norm(state.search);
  return DATA.filter(x=>{
    const hay=norm([x.nama,x.bidang,x.website,x.sosmed,x.lokasi,x.kontak].join(" "));
    const matchQ=!q || hay.includes(q);
    const matchI=!state.industry || x.bidang===state.industry;
    const loc=norm(x.lokasi);
    const matchA=!state.area || loc.includes(state.area);
    return matchQ && matchI && matchA;
  });
}
function sortData(arr){
  return [...arr].sort((a,b)=>{
    let av=a[state.sort], bv=b[state.sort];
    if(state.sort==="no"){ av=Number(av)||0; bv=Number(bv)||0; }
    else { av=norm(av); bv=norm(bv); }
    let c=av<bv?-1:av>bv?1:0;
    return state.dir==="asc"?c:-c;
  });
}
function render(){
  const filtered=sortData(getFiltered());
  const totalPages=Math.max(1,Math.ceil(filtered.length/state.pageSize));
  if(state.page>totalPages) state.page=totalPages;
  const start=(state.page-1)*state.pageSize;
  const rows=filtered.slice(start,start+state.pageSize);
  $("#resultInfo").textContent = filtered.length
    ? `Menampilkan ${start+1}–${Math.min(start+rows.length,filtered.length)} dari ${filtered.length} perusahaan`
    : "Tidak ada perusahaan yang cocok";
  $("#tbody").innerHTML = rows.length ? rows.map(row=>`
    <tr>
      <td class="no">${esc(row.no)}</td>
      <td><div class="company">${esc(row.nama)}</div></td>
      <td><span class="industry">${esc(row.bidang)}</span></td>
      <td>${websiteUrl(row.website) ? `<a class="link" href="${esc(websiteUrl(row.website))}" target="_blank" rel="noopener">${esc(row.website)}</a>` : '<span class="muted">-</span>'}</td>
      <td><div class="location">${esc(row.lokasi)}</div></td>
      <td>${row.kontak!=="-" ? `<span>${esc(row.kontak)}</span>` : '<span class="muted">-</span>'}</td>
      <td><button class="action" onclick="showDetail(${DATA.indexOf(row)})">Detail</button></td>
    </tr>`).join("") : `<tr><td colspan="7"><div class="empty">🔎<br><br>Tidak ada data yang sesuai dengan filter.</div></td></tr>`;
  renderPagination(totalPages);
  document.querySelectorAll(".th-btn").forEach(btn=>{
    const arrow=btn.querySelector(".sort");
    arrow.textContent = btn.dataset.sort===state.sort ? (state.dir==="asc"?"↑":"↓") : "↕";
  });
}
function renderPagination(totalPages){
  const p=$("#pagination");
  if(totalPages<=1){p.innerHTML=`<span class="muted">Halaman 1</span>`;return;}
  let pages=[];
  const add=n=>pages.push(n);
  if(totalPages<=7){for(let i=1;i<=totalPages;i++)add(i)}
  else{
    add(1);
    if(state.page>4) pages.push("…");
    for(let i=Math.max(2,state.page-2);i<=Math.min(totalPages-1,state.page+2);i++)add(i);
    if(state.page<totalPages-3) pages.push("…");
    add(totalPages);
  }
  p.innerHTML=`<button class="page-btn" ${state.page===1?"disabled":""} onclick="goPage(${state.page-1})">‹</button>
    <div class="pages">${pages.map(n=>n==="…"?"<span class='muted'>…</span>":`<button class="page-btn ${n===state.page?"active":""}" onclick="goPage(${n})">${n}</button>`).join("")}</div>
    <button class="page-btn" ${state.page===totalPages?"disabled":""} onclick="goPage(${state.page+1})">›</button>`;
}
function goPage(n){state.page=n;render();window.scrollTo({top:document.querySelector(".table-wrap").offsetTop-15,behavior:"smooth"});}
function showDetail(index){
  const x=DATA[index];
  $("#modalTitle").textContent=x.nama;
  const w=websiteUrl(x.website);
  $("#modalBody").innerHTML=`
    <div class="detail"><label>No</label><div>${esc(x.no)}</div></div>
    <div class="detail"><label>Bidang Usaha</label><div>${esc(x.bidang)}</div></div>
    <div class="detail full"><label>Lokasi Perusahaan</label><div>${esc(x.lokasi)}</div></div>
    <div class="detail"><label>Website Resmi</label><div>${w?`<a class="link" href="${esc(w)}" target="_blank" rel="noopener">${esc(x.website)}</a>`:'-'}</div></div>
    <div class="detail"><label>Sosial Media Resmi</label><div>${esc(x.sosmed)}</div></div>
    <div class="detail full"><label>Email / No. Telp</label><div>${esc(x.kontak)}</div></div>`;
  $("#modal").classList.add("show");
}
function bind(){
  $("#search").addEventListener("input",e=>{state.search=e.target.value;state.page=1;render()});
  $("#industry").addEventListener("change",e=>{state.industry=e.target.value;state.page=1;render()});
  $("#area").addEventListener("change",e=>{state.area=e.target.value;state.page=1;render()});
  $("#pageSize").addEventListener("change",e=>{state.pageSize=Number(e.target.value);state.page=1;render()});
  $("#reset").addEventListener("click",()=>{
    state={search:"",industry:"",area:"",page:1,pageSize:Number($("#pageSize").value),sort:"no",dir:"asc"};
    $("#search").value="";$("#industry").value="";$("#area").value="";render();
  });
  document.querySelectorAll(".th-btn").forEach(btn=>btn.addEventListener("click",()=>{
    const key=btn.dataset.sort;
    if(state.sort===key) state.dir=state.dir==="asc"?"desc":"asc";
    else {state.sort=key;state.dir="asc";}
    state.page=1;render();
  }));
  $("#closeModal").onclick=()=>$("#modal").classList.remove("show");
  $("#modal").addEventListener("click",e=>{if(e.target.id==="modal")$("#modal").classList.remove("show")});
  document.addEventListener("keydown",e=>{if(e.key==="Escape")$("#modal").classList.remove("show")});
}
init();
</script>
</body>
</html>
