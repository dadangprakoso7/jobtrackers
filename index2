<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Direktori Perusahaan Besar Surabaya & Sidoarjo</title>
<meta name="description" content="Direktori interaktif perusahaan besar di Surabaya dan Sidoarjo dengan pencarian, filter, sorting, pagination, dan detail perusahaan.">
<style>
:root{
  --bg:#f5f7fb; --surface:#fff; --surface2:#f8fafc; --text:#172033; --muted:#667085;
  --primary:#2563eb; --primary2:#1d4ed8; --border:#e5e7eb; --success:#059669;
  --shadow:0 10px 30px rgba(15,23,42,.07); --radius:18px;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input,select{font:inherit}
button{cursor:pointer}
.container{max-width:1440px;margin:auto;padding:28px}
.hero{
  background:linear-gradient(135deg,#0f172a 0%,#1e3a8a 58%,#2563eb 100%);
  color:#fff;border-radius:24px;padding:34px;box-shadow:var(--shadow);position:relative;overflow:hidden
}
.hero:after{content:"";position:absolute;width:320px;height:320px;border-radius:50%;right:-90px;top:-140px;background:rgba(255,255,255,.08)}
.hero h1{font-size:clamp(28px,4vw,46px);margin:0 0 10px;letter-spacing:-1.5px}
.hero p{margin:0;color:#dbeafe;max-width:760px;line-height:1.65}
.hero-badge{display:inline-flex;gap:8px;align-items:center;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);padding:7px 11px;border-radius:999px;font-size:13px;margin-bottom:16px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:20px 0}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
.stat .label{color:var(--muted);font-size:13px;margin-bottom:7px}
.stat .value{font-size:28px;font-weight:800;letter-spacing:-.8px}
.toolbar{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);margin-bottom:16px}
.controls{display:grid;grid-template-columns:minmax(260px,2fr) repeat(3,minmax(150px,1fr)) auto;gap:10px}
.field{position:relative}
.field input,.field select{width:100%;height:46px;border:1px solid var(--border);border-radius:12px;background:#fff;color:var(--text);padding:0 13px;outline:none}
.field input:focus,.field select:focus{border-color:#93c5fd;box-shadow:0 0 0 3px #dbeafe}
.search{padding-left:42px!important}
.search-icon{position:absolute;left:14px;top:13px;color:#98a2b3}
.btn{height:46px;border:0;border-radius:12px;padding:0 16px;background:var(--primary);color:#fff;font-weight:700;white-space:nowrap}
.btn:hover{background:var(--primary2)}
.btn.secondary{background:#eef2ff;color:#3730a3}
.btn.secondary:hover{background:#e0e7ff}
.toolbar-meta{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:13px;color:var(--muted);font-size:13px}
.table-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.table-scroll{overflow:auto}
table{border-collapse:collapse;width:100%;min-width:1080px}
thead{background:#f8fafc}
th{padding:0;text-align:left;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:2}
.th-btn{display:flex;align-items:center;gap:8px;width:100%;border:0;background:transparent;padding:15px 14px;color:#475467;font-size:12px;text-transform:uppercase;letter-spacing:.04em;font-weight:800;text-align:left}
.th-btn:hover{background:#f1f5f9}
td{padding:15px 14px;border-bottom:1px solid #eef0f3;vertical-align:top;font-size:14px}
tbody tr:hover{background:#fbfdff}
.no{width:58px;color:#98a2b3;font-weight:700}
.company{font-weight:800;color:#101828;line-height:1.4}
.industry{display:inline-flex;padding:5px 9px;border-radius:999px;background:#eff6ff;color:#1d4ed8;font-size:12px;font-weight:700;line-height:1.25}
.location{color:#475467;line-height:1.5}
.link{color:#2563eb;text-decoration:none;word-break:break-word}
.link:hover{text-decoration:underline}
.muted{color:#98a2b3}
.action{border:1px solid var(--border);background:#fff;border-radius:9px;padding:7px 10px;color:#344054;font-weight:700}
.action:hover{background:#f8fafc}
.pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px;border-top:1px solid var(--border)}
.pages{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.page-btn{min-width:38px;height:36px;border:1px solid var(--border);background:#fff;border-radius:9px;color:#475467}
.page-btn.active{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:800}
.page-btn:disabled{opacity:.45;cursor:not-allowed}
.empty{text-align:center;padding:55px 20px;color:var(--muted)}
.modal{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:20}
.modal.show{display:flex}
.dialog{width:min(720px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:22px;box-shadow:0 30px 80px rgba(0,0,0,.22)}
.dialog-head{padding:23px 24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:15px}
.dialog-head h2{margin:0;font-size:23px;line-height:1.3}
.close{width:38px;height:38px;border:0;border-radius:10px;background:#f2f4f7;font-size:22px}
.dialog-body{padding:24px}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.detail{background:var(--surface2);border:1px solid #edf0f4;border-radius:14px;padding:15px}
.detail.full{grid-column:1/-1}
.detail label{display:block;color:var(--muted);font-size:12px;font-weight:800;text-transform:uppercase;margin-bottom:7px}
.detail div{line-height:1.55}
.footer{text-align:center;color:#98a2b3;padding:25px 10px;font-size:13px}
@media(max-width:1000px){.controls{grid-template-columns:1fr 1fr}.controls .search-field{grid-column:1/-1}.stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.container{padding:14px}.hero{padding:24px;border-radius:18px}.stats{grid-template-columns:1fr 1fr;gap:10px}.stat{padding:15px}.stat .value{font-size:22px}.controls{grid-template-columns:1fr}.controls .search-field{grid-column:auto}.toolbar-meta{align-items:flex-start;flex-direction:column}.pagination{flex-direction:column;align-items:stretch}.pages{justify-content:center}.detail-grid{grid-template-columns:1fr}.detail.full{grid-column:auto}}
</style>
</head>
<body>
<div class="container">
  <section class="hero">
    <div class="hero-badge">📊 Direktori Data Perusahaan</div>
    <h1>Perusahaan Besar<br>Surabaya & Sidoarjo</h1>
    <p>Jelajahi daftar perusahaan dari data Excel dalam tampilan web yang cepat, responsif, dan mudah disortir berdasarkan nama, bidang usaha, lokasi, maupun kontak.</p>
  </section>

  <section class="stats" id="stats"></section>

  <section class="toolbar">
    <div class="controls">
      <div class="field search-field">
        <span class="search-icon">⌕</span>
        <input id="search" class="search" type="search" placeholder="Cari perusahaan, bidang usaha, lokasi, website..." autocomplete="off">
      </div>
      <div class="field"><select id="industry"><option value="">Semua bidang usaha</option></select></div>
      <div class="field"><select id="area"><option value="">Semua wilayah</option><option value="surabaya">Surabaya</option><option value="sidoarjo">Sidoarjo</option></select></div>
      <div class="field"><select id="pageSize"><option value="10">10 / halaman</option><option value="25">25 / halaman</option><option value="50">50 / halaman</option><option value="100">100 / halaman</option></select></div>
      <button class="btn secondary" id="reset">Reset</button>
    </div>
    <div class="toolbar-meta">
      <span id="resultInfo">Menampilkan data...</span>
      <span>💡 Klik judul kolom untuk sorting</span>
    </div>
  </section>

  <section class="table-wrap">
    <div class="table-scroll">
      <table>
        <thead><tr>
          <th><button class="th-btn" data-sort="no">No <span class="sort">↕</span></button></th>
          <th><button class="th-btn" data-sort="nama">Nama Perusahaan <span class="sort">↕</span></button></th>
          <th><button class="th-btn" data-sort="bidang">Bidang Usaha <span class="sort">↕</span></button></th>
          <th><button class="th-btn" data-sort="website">Website Resmi <span class="sort">↕</span></button></th>
          <th><button class="th-btn" data-sort="lokasi">Lokasi Perusahaan <span class="sort">↕</span></button></th>
          <th><button class="th-btn" data-sort="kontak">Email / No. Telp <span class="sort">↕</span></button></th>
          <th>Aksi</th>
        </tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
    <div id="pagination" class="pagination"></div>
  </section>

  <div class="footer">Direktori interaktif • Data bersumber dari file Excel yang diberikan</div>
</div>

<div class="modal" id="modal">
  <div class="dialog">
    <div class="dialog-head">
      <h2 id="modalTitle">Detail Perusahaan</h2>
      <button class="close" id="closeModal">×</button>
    </div>
    <div class="dialog-body"><div class="detail-grid" id="modalBody"></div></div>
  </div>
</div>

